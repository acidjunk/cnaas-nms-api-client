    "/auth/auth": {
      "get": {
        "summary": "Function to authenticate the user",
        "description": "This API call is called by the OAUTH login after the user has logged in.\nWe get the users token and redirect them to right page in the frontend.\n\nReturns:\n    A HTTP redirect response to the url in the frontend that handles the repsonse after login.\n    The access token is a parameter in the url",
        "operationId": "get_auth_api",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/auth/identity": {
      "get": {
        "operationId": "get_identity_api",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/auth/login": {
      "get": {
        "summary": "Function to initiate a login of the user",
        "description": "The user will be sent to the page to login.\nOur client info will also be checked.\n\nNote:\n    We also discussed adding state to this function.\n    That way you could be sent to the same page once you logged in.\n    We would put the relevant information in a dictionary,\n    base64 encode it and sent it around as a parameter.\n    For now the application is small and it didn't seem needed.\n\nReturns:\n    A HTTP redirect response to OIDC_CONF_WELL_KNOWN_URL we have defined.\n    We give the auth call as a parameter to redirect after login is successfull.",
        "operationId": "get_login_api",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/auth/permissions": {
      "get": {
        "operationId": "get_permissions_api",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
